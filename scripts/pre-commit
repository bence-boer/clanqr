#!/usr/bin/env bash
# Pre-commit hook -- lint (auto-fix), type-check, and unit tests.
# Installed by: ./scripts/dev-setup.sh  (or:  bun run prepare)
#
# E2E tests are excluded here because they require the full dev stack.
# Run them manually before pushing: bun run test:e2e

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

echo "[pre-commit] Linting & auto-fixing staged files..."
(cd "$ROOT" && bun run lint:fix)

# Re-stage any files that were auto-fixed
git diff --name-only | while IFS= read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo "[pre-commit] Syncing database types (if local DB is running)..."
(cd "$ROOT" && bun run gen-types || true)

echo "[pre-commit] Type-checking server..."
(cd "$ROOT/server" && bun run --bun tsc --noEmit)

echo "[pre-commit] Type-checking web..."
(cd "$ROOT/web" && bun run --bun check)

echo "[pre-commit] Running unit tests..."
(cd "$ROOT/server" && bun test)

echo "[pre-commit] All checks passed."
