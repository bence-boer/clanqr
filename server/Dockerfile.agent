FROM debian:bookworm-slim

# Minimal agent execution environment for ARM64 Pi
# Provides: git, python3, Node.js 22, curl, jq
# Agent CLIs (copilot/gemini) are bind-mounted from host at runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    python3-venv \
    python3-pip \
    curl \
    ca-certificates \
    jq \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 LTS via NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Create agent user matching host UID (1000) with sudo-free write access
RUN useradd -m -s /bin/bash -u 1000 agent && \
    mkdir -p /workspace && chown agent:agent /workspace && \
    mkdir -p /home/agent/.gemini /home/agent/.config /home/agent/.local/share && \
    chown -R agent:agent /home/agent

USER agent
WORKDIR /workspace

CMD ["sleep", "infinity"]
