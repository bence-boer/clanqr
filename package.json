{
    "name": "ralph-agent-workspace",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "workspaces": [
        "server",
        "web",
        "shared",
        "e2e"
    ],
    "scripts": {
        "dev": "bun run --filter '*' dev",
        "dev:server": "bun run --filter server dev",
        "dev:web": "bun run --filter web dev",
        "dev:db": "docker compose -f docker-compose.dev.yml up -d",
        "dev:db:stop": "docker compose -f docker-compose.dev.yml down",
        "dev:db:reset": "./scripts/dev-db-reset.sh",
        "dev:setup": "./scripts/dev-setup.sh",
        "check": "bun run check:server && bun run check:web",
        "check:server": "cd server && bun run --bun tsc --noEmit",
        "check:web": "cd web && bun run --bun check",
        "test": "cd server && bun test",
        "test:server": "cd server && bun test",
        "test:e2e": "cd e2e && bun x playwright test",
        "test:e2e:headed": "cd e2e && bun x playwright test --headed",
        "test:e2e:ui": "cd e2e && bun x playwright test --ui",
        "prepare": "mkdir -p .git/hooks && cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
        "lint": "eslint . --no-inline-config",
        "lint:fix": "eslint . --fix --no-inline-config"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "4.6.0",
        "@eslint/compat": "^2.0.2",
        "@eslint/js": "^9.39.2",
        "@stylistic/eslint-plugin": "^4.0.0",
        "@types/node": "^24",
        "eslint": "^9.39.2",
        "eslint-plugin-svelte": "^3.14.0",
        "globals": "^17.3.0",
        "jiti": "^2.6.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.0"
    }
}